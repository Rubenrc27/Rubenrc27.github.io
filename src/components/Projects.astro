---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const projects = [
	{
		num: "01",
		name: t('projects.p1.name'),
		desc: t('projects.p1.desc'),
		tags: ["Java", "Hibernate", "REST API", "SQL"],
		link: "https://github.com/Rubenrc27",
		color: "blue"
	},
	{
		num: "02",
		name: t('projects.p2.name'),
		desc: t('projects.p2.desc'),
		tags: ["Flutter", "Dart", "Mobile", "TFG"],
		link: "https://github.com/Rubenrc27",
		color: "pink"
	},
	{
		num: "03",
		name: t('projects.p3.name'),
		desc: t('projects.p3.desc'),
		tags: ["React", "Next.js", "TypeScript", "Monorepo"],
		link: "https://github.com/Rubenrc27",
		color: "cyan"
	}
];
---
<section id="proyectos">
	<div class="container">
		<span class="s-label">{t('projects.label')}</span>
		<h2 class="s-title">{t('projects.title')}</h2>
		<div class="proj-grid">
			{projects.map(proj => (
				<div class={`proj-card border-${proj.color}`}>
					<div class="card-glow"></div>
					<div class="card-content">
						<div class="proj-header">
							<span class="proj-num">Nº {proj.num}</span>
							<span class="proj-icon">
								<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
							</span>
						</div>
						<h3 class={`proj-name text-${proj.color}`}>{proj.name}</h3>
						<p class="proj-desc">{proj.desc}</p>
						<div class="proj-tags">
							{proj.tags.map(tag => <span class="proj-tag">{tag}</span>)}
						</div>
						<a href={proj.link} target="_blank" class="proj-link">
							<span>{t('projects.view')}</span>
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
						</a>
					</div>
				</div>
			))}
		</div>
	</div>
</section>

<style>
	.proj-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
		gap: 2.5rem;
	}
	.proj-card {
		position: relative;
		border-radius: 20px;
		background: rgba(15, 20, 25, 0.4);
		border: 1px solid rgba(255, 255, 255, 0.05);
		padding: 2.5rem;
		display: flex;
		flex-direction: column;
		transition: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
		backdrop-filter: blur(10px);
		z-index: 1;
		overflow: hidden;
	}
	.card-glow {
		position: absolute;
		top: 0; left: 0; right: 0;
		height: 100%;
		background: radial-gradient(circle at top left, var(--accent-color), transparent 60%);
		opacity: 0;
		transition: opacity 0.5s ease;
		z-index: -1;
		pointer-events: none;
	}
	
	.border-blue { --accent-color: rgba(0, 102, 255, 0.15); }
	.border-pink { --accent-color: rgba(255, 51, 102, 0.15); }
	.border-cyan { --accent-color: rgba(0, 255, 204, 0.15); }

	.proj-card:hover {
		transform: translateY(-10px);
		border-color: rgba(255, 255, 255, 0.15);
		box-shadow: 0 20px 40px rgba(0,0,0,0.5);
	}
	.proj-card:hover .card-glow {
		opacity: 1;
	}
	
	.proj-card::after {
		content: '';
		position: absolute;
		bottom: 0; left: 0; width: 0; height: 3px;
		background: var(--btn-color);
		transition: width 0.5s ease;
	}
	.proj-card.border-blue::after { --btn-color: var(--accent-4); }
	.proj-card.border-pink::after { --btn-color: var(--accent-1); }
	.proj-card.border-cyan::after { --btn-color: var(--accent-3); }
	
	.proj-card:hover::after {
		width: 100%;
	}

	.card-content {
		display: flex;
		flex-direction: column;
		flex: 1;
	}

	.proj-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 1.5rem;
	}
	.proj-num {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--muted);
		letter-spacing: 0.1em;
	}
	.proj-icon {
		color: var(--muted);
		opacity: 0.5;
		transition: all 0.3s ease;
	}
	.proj-card:hover .proj-icon {
		opacity: 1;
		transform: scale(1.1);
	}
	.border-blue:hover .proj-icon { color: var(--accent-4); }
	.border-pink:hover .proj-icon { color: var(--accent-1); }
	.border-cyan:hover .proj-icon { color: var(--accent-3); }

	.proj-name {
		font-size: 1.8rem;
		font-weight: 800;
		margin-bottom: 1rem;
		letter-spacing: -0.02em;
	}
	.text-blue { color: #fff; }
	.text-pink { color: #fff; }
	.text-cyan { color: #fff; }

	.proj-desc {
		color: var(--muted);
		font-size: 1rem;
		line-height: 1.7;
		margin-bottom: 2rem;
		flex: 1;
	}
	
	.proj-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin-bottom: 2rem;
	}
	.proj-tag {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid rgba(255,255,255,0.08);
		color: var(--muted);
		padding: 0.3rem 0.8rem;
		border-radius: 100px;
		transition: all 0.3s ease;
	}
	.proj-card:hover .proj-tag {
		background: rgba(255, 255, 255, 0.08);
		color: #fff;
	}

	.proj-link {
		font-family: var(--font-main);
		font-size: 0.95rem;
		color: var(--text);
		font-weight: 700;
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		transition: all 0.3s ease;
		align-self: flex-start;
		padding: 0.5rem 0;
	}
	.proj-link svg {
		transition: transform 0.3s ease;
	}
	.proj-card.border-blue .proj-link:hover { color: var(--accent-4); }
	.proj-card.border-pink .proj-link:hover { color: var(--accent-1); }
	.proj-card.border-cyan .proj-link:hover { color: var(--accent-3); }
	
	.proj-link:hover svg {
		transform: translateX(5px);
	}
</style>
