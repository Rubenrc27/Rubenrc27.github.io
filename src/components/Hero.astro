---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<section class="hero" id="inicio">
	<div class="cyber-grid"></div>
	<div class="hero-inner container">
		<div class="hero-content">
			<div class="terminal-header">
				<span class="dot red"></span>
				<span class="dot yellow"></span>
				<span class="dot green"></span>
				<span class="title">rrc27@sys: ~</span>
			</div>
			<div class="terminal-body">
				<p class="hero-eyebrow">> {t('hero.greeting')}</p>
				<h1 class="hero-name">
					<div class="glitch-wrapper"><span class="glitch" data-text="Rubén">Rubén</span></div><br />
					<div class="glitch-wrapper"><span class="glitch" data-text="Rodríguez">Rodríguez</span></div><br />
					<div class="glitch-wrapper"><span class="glitch" data-text="Cazorla">Cazorla</span></div>
				</h1>
				<p class="hero-sub">> <Fragment set:html={t('hero.subtitle')} /><br /><span class="blink-text">_ Java · React · Flutter _</span></p>
				
				<div class="hero-btns">
					<a href="/cv.pdf" download class="cyber-btn primary">
						<span class="btn-text">[{t('hero.cv')}]</span>
						<span class="btn-glitch"></span>
					</a>
					<a href="https://github.com/Rubenrc27" target="_blank" class="cyber-btn secondary">
						<span class="btn-text">[GITHUB]</span>
					</a>
					<a href="https://www.linkedin.com/in/rub%C3%A9n-rodr%C3%ADguez-b52790237/" target="_blank" class="cyber-btn secondary">
						<span class="btn-text">[LINKEDIN]</span>
					</a>
					<a href="https://rubenrc27.github.io/EsquivaCo/" target="_blank" class="cyber-btn accent">
						<span class="btn-text">>{t('hero.play')}<</span>
					</a>
				</div>
			</div>
		</div>
		<div class="hero-visual">
			<div class="cyber-frame">
				<div class="frame-corners"></div>
				<img src="/me.jpg" alt="Rubén Rodríguez Cazorla" class="profile-img" />
				<div class="scanline"></div>
			</div>
		</div>
	</div>
</section>

<style>
	.hero {
		min-height: 100vh;
		display: flex;
		align-items: center;
		position: relative;
		overflow: hidden;
		padding-top: 5rem;
		background: radial-gradient(circle at center, rgba(6, 182, 212, 0.05) 0%, transparent 70%);
	}
	.cyber-grid {
		position: absolute;
		inset: 0;
		background-image: 
			linear-gradient(rgba(74, 222, 128, 0.1) 1px, transparent 1px),
			linear-gradient(90deg, rgba(74, 222, 128, 0.1) 1px, transparent 1px);
		background-size: 50px 50px;
		transform: perspective(500px) rotateX(60deg) translateY(-100px) translateZ(-200px);
		animation: grid-move 20s linear infinite;
		opacity: 0.3;
		z-index: 0;
		pointer-events: none;
	}
	@keyframes grid-move {
		0% { background-position: 0 0; }
		100% { background-position: 0 50px; }
	}
	
	.hero-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 4rem;
		z-index: 1;
		width: 100%;
	}
	.hero-content {
		flex: 1;
		background: rgba(11, 17, 21, 0.8);
		border: 1px solid var(--border);
		border-radius: 4px;
		box-shadow: 0 0 20px rgba(6, 182, 212, 0.1);
		backdrop-filter: blur(10px);
		position: relative;
	}
	
	.terminal-header {
		background: #090e11;
		padding: 8px 16px;
		border-bottom: 1px solid var(--border);
		display: flex;
		align-items: center;
		gap: 8px;
	}
	.dot {
		width: 12px;
		height: 12px;
		border-radius: 50%;
	}
	.dot.red { background: var(--accent-5); box-shadow: 0 0 5px var(--accent-5); }
	.dot.yellow { background: var(--accent-4); box-shadow: 0 0 5px var(--accent-4); }
	.dot.green { background: var(--accent-3); box-shadow: 0 0 5px var(--accent-3); }
	
	.terminal-header .title {
		margin-left: auto;
		color: var(--muted);
		font-size: 0.8rem;
		font-family: var(--font-mono);
	}
	
	.terminal-body {
		padding: 2rem;
	}

	.hero-eyebrow {
		font-family: var(--font-mono);
		font-size: 1rem;
		color: var(--accent-1);
		margin-bottom: 1rem;
	}
	.hero-name {
		font-size: clamp(2rem, 8vw, 5rem);
		font-weight: 800;
		line-height: 1;
		margin-bottom: 1.5rem;
		text-transform: uppercase;
		letter-spacing: -2px;
	}
	.hero-sub {
		font-size: 1.1rem;
		color: var(--muted);
		margin-bottom: 2.5rem;
		font-family: var(--font-mono);
	}
	.hero-sub strong {
		color: var(--accent-2);
	}
	.blink-text {
		color: var(--text);
		animation: blink-caret 1s step-end infinite;
	}
	@keyframes blink-caret {
		50% { opacity: 0; }
	}
	
	.hero-btns {
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
	}
	.cyber-btn {
		position: relative;
		padding: 0.8rem 1.5rem;
		font-family: var(--font-mono);
		font-size: 0.9rem;
		font-weight: bold;
		text-transform: uppercase;
		background: transparent;
		cursor: pointer;
		overflow: hidden;
		transition: all 0.2s ease;
		display: inline-block;
	}
	.cyber-btn::before {
		content: '';
		position: absolute;
		top: 0; left: 0;
		width: 10px; height: 100%;
		background: rgba(255,255,255,0.1);
		transform: skewX(-15deg) translateX(-20px);
		transition: all 0.3s ease;
	}
	.cyber-btn:hover::before {
		transform: skewX(-15deg) translateX(150px);
	}
	
	.cyber-btn.primary {
		color: #05080a;
		background: var(--accent-1);
		border: 1px solid var(--accent-1);
		box-shadow: 0 0 15px rgba(74, 222, 128, 0.4);
	}
	.cyber-btn.primary:hover {
		box-shadow: 0 0 25px rgba(74, 222, 128, 0.7);
		transform: translateY(-2px);
	}
	
	.cyber-btn.secondary {
		color: var(--accent-2);
		border: 1px solid var(--accent-2);
	}
	.cyber-btn.secondary:hover {
		background: rgba(6, 182, 212, 0.1);
		box-shadow: inset 0 0 10px rgba(6, 182, 212, 0.3);
	}
	
	.cyber-btn.accent {
		color: var(--accent-5);
		border: 1px dashed var(--accent-5);
	}
	.cyber-btn.accent:hover {
		background: rgba(244, 63, 94, 0.1);
		border-style: solid;
	}

	.hero-visual {
		position: relative;
		width: 350px;
		height: 350px;
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.cyber-frame {
		position: relative;
		width: 300px;
		height: 300px;
		border: 2px solid var(--accent-2);
		background: var(--surface);
		overflow: hidden;
		box-shadow: 0 0 30px rgba(6, 182, 212, 0.2);
	}
	.frame-corners {
		position: absolute;
		inset: -5px;
		border: 2px solid var(--accent-1);
		clip-path: polygon(
			0 15px, 15px 0,
			calc(100% - 15px) 0, 100% 15px,
			100% calc(100% - 15px), calc(100% - 15px) 100%,
			15px 100%, 0 calc(100% - 15px)
		);
		pointer-events: none;
		z-index: 2;
	}
	.profile-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		filter: contrast(1.2) sepia(0.3) hue-rotate(150deg) saturate(1.5); /* Techy filter */
		transition: filter 0.3s ease;
	}
	.cyber-frame:hover .profile-img {
		filter: contrast(1.1) sepia(0) hue-rotate(0) saturate(1); /* Reveal original on hover */
	}
	.scanline {
		position: absolute;
		top: 0; left: 0;
		width: 100%; height: 5px;
		background: rgba(74, 222, 128, 0.5);
		box-shadow: 0 0 10px var(--accent-1);
		opacity: 0.6;
		animation: scan 4s linear infinite;
		z-index: 3;
		pointer-events: none;
	}
	@keyframes scan {
		0% { top: -10%; }
		100% { top: 110%; }
	}

	@media (max-width: 900px) {
		.hero-inner {
			flex-direction: column-reverse;
			text-align: left;
			gap: 3rem;
		}
		.hero-content {
			width: 100%;
		}
		.hero-btns {
			justify-content: flex-start;
		}
		.hero-visual {
			width: 280px;
			height: 280px;
			margin: 0 auto;
		}
		.cyber-frame {
			width: 250px;
			height: 250px;
		}
	}
</style>
