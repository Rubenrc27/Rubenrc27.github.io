---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<section class="hero" id="inicio">
	<div class="blob-container">
		<div class="blob b1"></div>
		<div class="blob b2"></div>
		<div class="blob b3"></div>
	</div>
	
	<!-- Glass overlay to make the blobs look like an aurora -->
	<div class="glass-overlay"></div>

	<div class="hero-inner container">
		<div class="hero-content">
			<div class="availability-badge">
				<span class="pulse-dot"></span> Available for new projects
			</div>
			
			<h1 class="hero-name">
				<span class="text-glow">Rubén</span><br />
				Rodríguez<br />
				<span class="grad-anim">Cazorla</span>
			</h1>
			
			<p class="hero-sub"><Fragment set:html={t('hero.subtitle')} /><br /><span class="sub-tech">Java · React · Flutter · Next.js</span></p>
			
			<div class="hero-btns">
				<a href="/cv.pdf" download class="btn btn-primary">
					<span class="btn-content">{t('hero.cv')}</span>
				</a>
				<a href="https://github.com/Rubenrc27" target="_blank" class="btn btn-glass">
					<span class="btn-content">GitHub</span>
				</a>
				<a href="https://www.linkedin.com/in/rub%C3%A9n-rodr%C3%ADguez-b52790237/" target="_blank" class="btn btn-glass">
					<span class="btn-content">LinkedIn</span>
				</a>
				<a href="https://rubenrc27.github.io/EsquivaCo/" target="_blank" class="btn btn-outline">
					<span class="btn-content">{t('hero.play')}</span>
				</a>
			</div>
		</div>
		
		<div class="hero-visual">
			<div class="photo-wrapper">
				<div class="photo-ring r1"></div>
				<div class="photo-ring r2"></div>
				<div class="photo-ring r3"></div>
				<div class="photo-inner">
					<img src="/me.jpg" alt="Rubén Rodríguez Cazorla" class="profile-img" />
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.hero {
		min-height: 100vh;
		display: flex;
		align-items: center;
		position: relative;
		overflow: hidden;
		padding-top: 5rem;
	}
	
	/* Aurora Blobs */
	.blob-container {
		position: absolute;
		inset: 0;
		z-index: 0;
		filter: blur(80px);
		opacity: 0.6;
		pointer-events: none;
		overflow: hidden;
	}
	.blob {
		position: absolute;
		border-radius: 50%;
		mix-blend-mode: screen;
		animation: aurora 20s infinite alternate ease-in-out;
	}
	.b1 {
		width: 50vw; height: 50vw;
		background: radial-gradient(circle, var(--accent-4), transparent 70%);
		top: -10%; right: -10%;
		animation-duration: 25s;
	}
	.b2 {
		width: 40vw; height: 40vw;
		background: radial-gradient(circle, var(--accent-5), transparent 70%);
		bottom: -10%; left: -10%;
		animation-duration: 20s;
		animation-delay: -5s;
	}
	.b3 {
		width: 45vw; height: 45vw;
		background: radial-gradient(circle, var(--accent-3), transparent 70%);
		top: 30%; left: 30%;
		animation-duration: 30s;
		animation-delay: -10s;
	}
	@keyframes aurora {
		0% { transform: translate(0, 0) scale(1) rotate(0deg); }
		50% { transform: translate(5vw, 10vh) scale(1.1) rotate(180deg); }
		100% { transform: translate(-5vw, -5vh) scale(0.9) rotate(360deg); }
	}
	
	.glass-overlay {
		position: absolute;
		inset: 0;
		background: rgba(3, 4, 6, 0.4); /* Darkens the blobs slightly */
		z-index: 0;
		backdrop-filter: blur(30px);
	}

	.hero-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 4rem;
		z-index: 1;
		width: 100%;
	}
	.hero-content {
		flex: 1;
	}
	
	.availability-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		background: rgba(255, 255, 255, 0.05);
		border: 1px solid rgba(255, 255, 255, 0.1);
		padding: 0.5rem 1rem;
		border-radius: 100px;
		font-size: 0.8rem;
		font-family: var(--font-mono);
		margin-bottom: 1.5rem;
		backdrop-filter: blur(10px);
	}
	.pulse-dot {
		width: 8px; height: 8px;
		background: var(--accent-3);
		border-radius: 50%;
		box-shadow: 0 0 10px var(--accent-3);
		animation: pulse 2s infinite;
	}
	@keyframes pulse {
		0% { box-shadow: 0 0 0 0 rgba(0, 255, 204, 0.4); }
		70% { box-shadow: 0 0 0 6px rgba(0, 255, 204, 0); }
		100% { box-shadow: 0 0 0 0 rgba(0, 255, 204, 0); }
	}

	.hero-name {
		font-size: clamp(3rem, 8vw, 6.5rem);
		font-weight: 900;
		line-height: 0.95;
		margin-bottom: 1.5rem;
		letter-spacing: -0.02em;
	}
	.text-glow {
		color: #fff;
		text-shadow: 0 0 20px rgba(255,255,255,0.3);
	}
	.grad-anim {
		background: linear-gradient(to right, var(--accent-1), var(--accent-5), var(--accent-4), var(--accent-3));
		background-size: 300% 300%;
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		animation: grad-shift 8s ease infinite;
	}
	@keyframes grad-shift {
		0% { background-position: 0% 50%; }
		50% { background-position: 100% 50%; }
		100% { background-position: 0% 50%; }
	}

	.hero-sub {
		font-size: 1.3rem;
		color: var(--muted);
		margin-bottom: 2.5rem;
		max-width: 600px;
	}
	.hero-sub strong {
		color: #fff;
	}
	.sub-tech {
		display: inline-block;
		margin-top: 0.5rem;
		font-family: var(--font-mono);
		font-size: 0.9rem;
		color: var(--accent-3);
	}

	/* PREMIUM BUTTONS */
	.hero-btns {
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
	}
	.btn {
		position: relative;
		padding: 2px; /* For gradient border */
		border-radius: 12px;
		font-family: var(--font-main);
		font-size: 1rem;
		font-weight: 600;
		text-decoration: none;
		transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
		overflow: hidden;
		display: inline-flex;
	}
	.btn:hover {
		transform: translateY(-5px);
	}
	.btn-content {
		display: block;
		padding: 0.8rem 1.8rem;
		background: var(--bg);
		border-radius: 10px;
		transition: background 0.3s ease;
	}
	
	.btn-primary {
		background: linear-gradient(135deg, var(--accent-4), var(--accent-5));
		box-shadow: 0 10px 20px rgba(0, 102, 255, 0.3);
	}
	.btn-primary .btn-content {
		background: transparent;
		color: #fff;
	}
	
	.btn-glass {
		background: rgba(255,255,255,0.1);
	}
	.btn-glass .btn-content {
		background: rgba(15, 20, 25, 0.8);
		color: var(--text);
		backdrop-filter: blur(10px);
	}
	.btn-glass:hover {
		background: linear-gradient(135deg, rgba(255,255,255,0.4), rgba(255,255,255,0.1));
		box-shadow: 0 10px 20px rgba(0, 0, 0, 0.4);
	}
	
	.btn-outline {
		background: linear-gradient(135deg, var(--accent-3), transparent);
	}
	.btn-outline .btn-content {
		background: var(--bg);
		color: var(--accent-3);
	}
	.btn-outline:hover .btn-content {
		background: rgba(0, 255, 204, 0.1);
	}

	/* PREMIUM VISUAL RING */
	.hero-visual {
		position: relative;
		width: 400px;
		height: 400px;
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.photo-wrapper {
		position: relative;
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
	}
	
	.photo-ring {
		position: absolute;
		inset: 0;
		border-radius: 50%;
		border: 1px solid transparent;
		pointer-events: none;
	}
	.r1 {
		inset: 20px;
		border-top-color: var(--accent-4);
		border-bottom-color: rgba(0, 102, 255, 0.2);
		animation: spin 15s linear infinite;
	}
	.r2 {
		inset: 10px;
		border-right-color: var(--accent-5);
		border-left-color: rgba(153, 0, 255, 0.2);
		animation: spin 20s linear infinite reverse;
	}
	.r3 {
		inset: 0;
		border: 1px dashed rgba(255,255,255,0.1);
		animation: spin 30s linear infinite;
	}
	
	.r1::after, .r2::after {
		content: '';
		position: absolute;
		width: 8px; height: 8px;
		background: #fff;
		border-radius: 50%;
		box-shadow: 0 0 10px #fff;
	}
	.r1::after { top: 0; left: 50%; transform: translateX(-50%); background: var(--accent-4); box-shadow: 0 0 15px var(--accent-4); }
	.r2::after { top: 50%; right: 0; transform: translateY(-50%); background: var(--accent-5); box-shadow: 0 0 15px var(--accent-5); }

	@keyframes spin {
		from { transform: rotate(0deg); }
		to { transform: rotate(360deg); }
	}

	.photo-inner {
		width: 280px;
		height: 280px;
		border-radius: 50%;
		padding: 5px;
		background: linear-gradient(135deg, var(--accent-4), var(--accent-5));
		animation: float 6s ease-in-out infinite;
	}
	.profile-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 50%;
		background: var(--bg);
	}
	
	@keyframes float {
		0%, 100% { transform: translateY(0); }
		50% { transform: translateY(-15px); }
	}

	@media (max-width: 900px) {
		.hero-inner {
			flex-direction: column-reverse;
			text-align: center;
			gap: 3rem;
		}
		.hero-sub {
			margin: 0 auto 2.5rem;
		}
		.hero-btns { 
			justify-content: center; 
		}
		.hero-visual { 
			width: 320px; 
			height: 320px;
		}
		.photo-inner {
			width: 220px;
			height: 220px;
		}
	}
</style>
