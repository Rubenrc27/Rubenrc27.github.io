---
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';
import { languages } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---
<nav class="cyber-nav">
	<div class="nav-container">
		<a href={translatePath('/')} class="nav-logo">
			<span class="glitch" data-text="SYS_ADMIN">SYS_ADMIN</span><span class="blink">_</span>
		</a>
		
		<div class="nav-right">
			<div class="lang-dropdown">
				<button class="drop-btn cyber-bracket" aria-label="Cambiar idioma">
					[{lang.toUpperCase()}]
				</button>
				<div class="dropdown-content cyber-panel">
					{Object.entries(languages).map(([code, label]) => (
						<a href={`/${code}/`} class={lang === code ? 'active' : ''}>
							<span class="lang-code">[{code.toUpperCase()}]</span>
							<span class="lang-label">{label}</span>
						</a>
					))}
				</div>
			</div>

			<button class="mobile-toggle" aria-label="Abrir menú">
				<span class="bar"></span>
				<span class="bar"></span>
				<span class="bar"></span>
			</button>
			<div class="nav-links">
				<a href="#sobre-mi" class="cyber-link">/{t('nav.about')}</a>
				<a href="#stack" class="cyber-link">/{t('nav.stack')}</a>
				<a href="#sistemas" class="cyber-link">/{t('nav.systems')}</a>
				<a href="#proyectos" class="cyber-link">/{t('nav.projects')}</a>
				<a href="#contacto" class="cyber-link">/{t('nav.contact')}</a>
			</div>
		</div>
	</div>
	<div class="nav-border"></div>
</nav>

<script>
	const toggle = document.querySelector('.mobile-toggle');
	const links = document.querySelector('.nav-links');
	const navLinks = document.querySelectorAll('.nav-links a');

	toggle?.addEventListener('click', () => {
		toggle.classList.toggle('active');
		links?.classList.toggle('active');
		document.body.classList.toggle('menu-open');
	});

	navLinks.forEach(link => {
		link.addEventListener('click', () => {
			toggle?.classList.remove('active');
			links?.classList.remove('active');
			document.body.classList.remove('menu-open');
		});
	});
</script>

<style>
	.cyber-nav {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 100;
		background: rgba(5, 8, 10, 0.9);
		backdrop-filter: blur(10px);
	}
	.nav-border {
		height: 2px;
		width: 100%;
		background: linear-gradient(90deg, transparent, var(--accent-2), var(--accent-1), transparent);
		box-shadow: 0 0 10px var(--accent-2);
	}
	
	.nav-container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 1rem 2rem;
		display: flex;
		justify-content: space-between;
		align-items: center;
	}
	.nav-logo {
		font-family: var(--font-mono);
		font-size: 1rem;
		color: var(--accent-1);
		font-weight: bold;
		letter-spacing: 2px;
	}
	.blink {
		animation: blink-anim 1s step-end infinite;
	}
	@keyframes blink-anim { 50% { opacity: 0; } }

	.nav-right {
		display: flex;
		align-items: center;
		gap: 2rem;
	}
	.nav-links {
		display: flex;
		gap: 2rem;
	}
	.cyber-link {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--muted);
		text-transform: uppercase;
		letter-spacing: 1px;
		transition: all 0.2s ease;
		position: relative;
	}
	.cyber-link:hover {
		color: var(--accent-2);
		text-shadow: 0 0 8px var(--accent-2);
	}
	.cyber-link::before {
		content: '>';
		position: absolute;
		left: -12px;
		opacity: 0;
		color: var(--accent-1);
		transition: opacity 0.2s;
	}
	.cyber-link:hover::before {
		opacity: 1;
	}

	.lang-dropdown {
		position: relative;
		display: inline-block;
	}
	.drop-btn {
		background: transparent;
		border: none;
		color: var(--accent-1);
		font-family: var(--font-mono);
		font-size: 0.8rem;
		font-weight: bold;
		cursor: pointer;
		transition: color 0.3s ease;
	}
	.drop-btn:hover {
		color: var(--text);
		text-shadow: 0 0 8px var(--text);
	}

	.dropdown-content {
		position: absolute;
		top: 100%;
		right: 0;
		margin-top: 1rem;
		background: var(--surface);
		border: 1px solid var(--border);
		min-width: 150px;
		box-shadow: 0 5px 15px rgba(0,0,0,0.8);
		opacity: 0;
		visibility: hidden;
		transform: translateY(10px);
		transition: all 0.3s ease;
		z-index: 1000;
	}
	.dropdown-content::before {
		content: '';
		position: absolute;
		top: -1px; left: -1px;
		width: 10px; height: 10px;
		border-top: 2px solid var(--accent-1);
		border-left: 2px solid var(--accent-1);
	}
	.dropdown-content::after {
		content: '';
		position: absolute;
		bottom: -1px; right: -1px;
		width: 10px; height: 10px;
		border-bottom: 2px solid var(--accent-1);
		border-right: 2px solid var(--accent-1);
	}

	.lang-dropdown:hover .dropdown-content {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
	}

	.dropdown-content a {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.8rem 1rem;
		text-decoration: none;
		font-family: var(--font-mono);
		color: var(--muted);
		transition: all 0.2s;
		border-bottom: 1px solid rgba(255,255,255,0.05);
	}
	.dropdown-content a:last-child { border-bottom: none; }

	.dropdown-content a:hover {
		background: rgba(6, 182, 212, 0.1);
		color: var(--accent-2);
		padding-left: 1.5rem;
	}
	.dropdown-content a.active {
		color: var(--accent-1);
	}
	.lang-code {
		font-size: 0.7rem;
		font-weight: bold;
	}
	.lang-label {
		font-size: 0.8rem;
	}

	.mobile-toggle {
		display: none;
		flex-direction: column;
		gap: 5px;
		background: none;
		border: 1px solid var(--accent-2);
		padding: 6px;
		cursor: pointer;
		z-index: 101;
	}
	.bar {
		width: 20px;
		height: 2px;
		background: var(--accent-2);
		transition: all 0.3s ease;
	}

	@media (max-width: 800px) {
		.mobile-toggle { display: flex; }
		.mobile-toggle.active .bar:nth-child(1) { transform: translateY(7px) rotate(45deg); }
		.mobile-toggle.active .bar:nth-child(2) { opacity: 0; }
		.mobile-toggle.active .bar:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

		.nav-links {
			position: fixed;
			top: 0; right: -100%;
			width: 100%; height: 100vh;
			background: rgba(5, 8, 10, 0.98);
			flex-direction: column;
			align-items: center;
			justify-content: center;
			transition: right 0.4s ease;
			z-index: 100;
			border-left: 2px solid var(--accent-2);
		}
		.nav-links.active { right: 0; }
		.cyber-link { font-size: 1.5rem; margin: 1rem 0; }
		.nav-right { gap: 1rem; }
	}
</style>
