---
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';
import { languages } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---
<nav class="premium-nav-wrapper">
	<div class="nav-container premium-nav">
		<a href={translatePath('/')} class="nav-logo">
			<div class="logo-orb"></div>
			<span class="logo-text">Rubén<span class="logo-dot">.</span></span>
		</a>
		
		<div class="nav-links">
			<a href="#sobre-mi" class="nav-link">
				<span class="link-text">{t('nav.about')}</span>
				<span class="link-glow"></span>
			</a>
			<a href="#stack" class="nav-link">
				<span class="link-text">{t('nav.stack')}</span>
				<span class="link-glow"></span>
			</a>
			<a href="#sistemas" class="nav-link">
				<span class="link-text">{t('nav.systems')}</span>
				<span class="link-glow"></span>
			</a>
			<a href="#proyectos" class="nav-link">
				<span class="link-text">{t('nav.projects')}</span>
				<span class="link-glow"></span>
			</a>
			<a href="#contacto" class="nav-link">
				<span class="link-text">{t('nav.contact')}</span>
				<span class="link-glow"></span>
			</a>
		</div>

		<div class="nav-right">
			<div class="tools-dropdown">
				<button class="drop-btn tools-drop-btn" aria-label={t('nav.tools')}>
					<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
					</svg>
					<span class="tools-txt">{t('nav.tools')}</span>
					<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
				</button>
				<div class="dropdown-content tools-menu">
					<a href="https://rubenrc27.github.io/jwt-decoder/" target="_blank" rel="noopener noreferrer">
						<div class="nav-tool-item">
							<span class="nav-tool-icon">🔑</span>
							<div class="nav-tool-info">
								<span class="nav-tool-title">JWT Decoder</span>
								<span class="nav-tool-desc">{t('tools.jwt.desc')}</span>
							</div>
							<svg class="external-arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
						</div>
					</a>
					<a href="https://rubenrc27.github.io/Texto-en-una-linea/" target="_blank" rel="noopener noreferrer">
						<div class="nav-tool-item">
							<span class="nav-tool-icon">📝</span>
							<div class="nav-tool-info">
								<span class="nav-tool-title">Texto en una línea</span>
								<span class="nav-tool-desc">{t('tools.text.desc')}</span>
							</div>
							<svg class="external-arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
						</div>
					</a>
				</div>
			</div>

			<div class="lang-dropdown">
				<button class="drop-btn" aria-label="Cambiar idioma">
					<span class="lang-txt">{lang.toUpperCase()}</span>
					<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
				</button>
				<div class="dropdown-content">
					{Object.entries(languages).map(([code, label]) => (
						<a href={`/${code}/`} class={lang === code ? 'active' : ''}>
							<div class="lang-item">
								<span class="lang-orb"></span>
								<span>{label}</span>
							</div>
						</a>
					))}
				</div>
			</div>

			<button class="mobile-toggle" aria-label="Abrir menú">
				<span class="bar"></span>
				<span class="bar"></span>
				<span class="bar"></span>
			</button>
		</div>
	</div>
</nav>

<div class="mobile-menu">
	<div class="mobile-bg-glow"></div>
	<div class="mobile-links">
		<a href="#sobre-mi" class="mobile-link">{t('nav.about')}</a>
		<a href="#stack" class="mobile-link">{t('nav.stack')}</a>
		<a href="#sistemas" class="mobile-link">{t('nav.systems')}</a>
		<a href="#proyectos" class="mobile-link">{t('nav.projects')}</a>
		<a href="#contacto" class="mobile-link">{t('nav.contact')}</a>
		<div class="mobile-tools-box">
			<span class="mobile-tools-tag">{t('hero.tools')}</span>
			<div class="mobile-tools-grid">
				<a href="https://rubenrc27.github.io/jwt-decoder/" target="_blank" rel="noopener noreferrer" class="mobile-tool-card">
					<span>JWT Decoder</span>
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
				</a>
				<a href="https://rubenrc27.github.io/Texto-en-una-linea/" target="_blank" rel="noopener noreferrer" class="mobile-tool-card">
					<span>Texto en una línea</span>
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
				</a>
			</div>
		</div>
	</div>
</div>

<script>
	const toggle = document.querySelector('.mobile-toggle');
	const mobileMenu = document.querySelector('.mobile-menu');
	const navLinks = document.querySelectorAll('.mobile-link, .nav-link, .mobile-tool-card');
	const toolsBtn = document.querySelector('.tools-dropdown .drop-btn');
	const toolsDropdown = document.querySelector('.tools-dropdown');

	toggle?.addEventListener('click', () => {
		toggle.classList.toggle('active');
		mobileMenu?.classList.toggle('active');
		document.body.classList.toggle('menu-open');
	});

	toolsBtn?.addEventListener('click', (e) => {
		e.stopPropagation();
		toolsDropdown?.classList.toggle('active');
	});

	document.addEventListener('click', (e) => {
		if (!toolsDropdown?.contains(e.target as Node)) {
			toolsDropdown?.classList.remove('active');
		}
	});

	navLinks.forEach(link => {
		link.addEventListener('click', () => {
			toggle?.classList.remove('active');
			mobileMenu?.classList.remove('active');
			document.body.classList.remove('menu-open');
		});
	});
</script>

<style>
	.premium-nav-wrapper {
		position: fixed;
		top: 1.5rem;
		left: 0;
		right: 0;
		display: flex;
		justify-content: center;
		z-index: 100;
		padding: 0 1rem;
		pointer-events: none; /* Let clicks pass through the wrapper */
	}
	.premium-nav {
		background: rgba(15, 20, 25, 0.4);
		border: 1px solid rgba(255, 255, 255, 0.05);
		border-radius: 100px;
		padding: 0.5rem 1.5rem;
		display: flex;
		justify-content: space-between;
		align-items: center;
		width: 100%;
		max-width: 1000px;
		backdrop-filter: blur(20px);
		-webkit-backdrop-filter: blur(20px);
		box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2), inset 0 0 0 1px rgba(255,255,255,0.05);
		transition: all 0.4s ease;
		pointer-events: auto; /* Enable clicks on the nav itself */
	}
	.premium-nav:hover {
		background: rgba(15, 20, 25, 0.6);
		border-color: rgba(255, 255, 255, 0.1);
		box-shadow: 0 15px 50px rgba(0, 102, 255, 0.15), inset 0 0 0 1px rgba(255,255,255,0.1);
	}

	.nav-logo {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		font-weight: 800;
		font-size: 1.2rem;
		letter-spacing: -0.02em;
	}
	.logo-orb {
		width: 14px;
		height: 14px;
		background: linear-gradient(135deg, var(--accent-4), var(--accent-5));
		border-radius: 50%;
		box-shadow: 0 0 15px var(--accent-4);
		animation: orb-pulse 3s infinite alternate;
	}
	@keyframes orb-pulse {
		0% { transform: scale(1); box-shadow: 0 0 10px var(--accent-4); }
		100% { transform: scale(1.1); box-shadow: 0 0 20px var(--accent-5); }
	}
	.logo-text {
		color: #fff;
	}
	.logo-dot {
		color: var(--accent-4);
	}

	.nav-links {
		display: flex;
		gap: 0.5rem;
		align-items: center;
	}
	.nav-link {
		position: relative;
		padding: 0.6rem 1.2rem;
		border-radius: 100px;
		overflow: hidden;
	}
	.link-text {
		position: relative;
		font-size: 0.9rem;
		font-weight: 500;
		color: var(--muted);
		z-index: 2;
		transition: color 0.3s ease;
	}
	.link-glow {
		position: absolute;
		inset: 0;
		background: linear-gradient(90deg, transparent, rgba(255,255,255,0.1), transparent);
		z-index: 1;
		transform: translateX(-100%);
		transition: transform 0.5s ease;
	}
	.nav-link:hover .link-text {
		color: #fff;
	}
	.nav-link:hover .link-glow {
		transform: translateX(100%);
	}
	.nav-link::after {
		content: '';
		position: absolute;
		bottom: 0; left: 50%;
		width: 0; height: 2px;
		background: linear-gradient(90deg, var(--accent-4), var(--accent-5));
		transition: all 0.3s ease;
		transform: translateX(-50%);
		border-radius: 2px;
	}
	.nav-link:hover::after {
		width: 40%;
	}

	.nav-right {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.tools-dropdown {
		position: relative;
	}
	.tools-drop-btn {
		gap: 0.4rem;
	}
	.tools-dropdown:hover .drop-btn svg:last-child,
	.tools-dropdown.active .drop-btn svg:last-child {
		transform: rotate(180deg);
	}
	.tools-dropdown:hover .tools-menu,
	.tools-dropdown.active .tools-menu {
		opacity: 1;
		visibility: visible;
		transform: translateY(0) scale(1);
	}
	.tools-menu {
		min-width: 280px;
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}
	.nav-tool-item {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.65rem 0.85rem;
		border-radius: 10px;
		transition: all 0.2s ease;
	}
	.nav-tool-item:hover {
		background: rgba(255, 255, 255, 0.06);
	}
	.nav-tool-icon {
		font-size: 1.1rem;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}
	.nav-tool-info {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		flex: 1;
		min-width: 0;
	}
	.nav-tool-title {
		font-size: 0.85rem;
		font-weight: 600;
		color: #fff;
	}
	.nav-tool-desc {
		font-size: 0.72rem;
		color: var(--muted);
		line-height: 1.25;
	}
	.external-arrow {
		color: var(--muted);
		transition: transform 0.2s ease, color 0.2s ease;
		flex-shrink: 0;
	}
	.nav-tool-item:hover .external-arrow {
		color: var(--accent-3);
		transform: translate(2px, -2px);
	}

	.lang-dropdown {
		position: relative;
	}
	.drop-btn {
		background: transparent;
		border: 1px solid rgba(255,255,255,0.1);
		color: var(--text);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 600;
		padding: 0.5rem 0.8rem;
		border-radius: 100px;
		display: flex;
		align-items: center;
		gap: 0.4rem;
		cursor: pointer;
		transition: all 0.3s ease;
	}
	.drop-btn:hover {
		background: rgba(255, 255, 255, 0.05);
		border-color: rgba(255,255,255,0.2);
	}
	.drop-btn svg {
		transition: transform 0.3s ease;
		color: var(--muted);
	}
	.lang-dropdown:hover .drop-btn svg {
		transform: rotate(180deg);
	}

	.dropdown-content {
		position: absolute;
		top: calc(100% + 15px);
		right: 0;
		background: rgba(15, 20, 25, 0.9);
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 16px;
		padding: 0.5rem;
		min-width: 140px;
		box-shadow: 0 15px 40px rgba(0, 0, 0, 0.4);
		backdrop-filter: blur(20px);
		opacity: 0;
		visibility: hidden;
		transform: translateY(10px) scale(0.95);
		transform-origin: top right;
		transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
	}
	.lang-dropdown:hover .dropdown-content {
		opacity: 1;
		visibility: visible;
		transform: translateY(0) scale(1);
	}
	.lang-item {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.7rem 1rem;
		font-size: 0.9rem;
		font-weight: 500;
		color: var(--muted);
		border-radius: 8px;
		transition: all 0.2s ease;
	}
	.lang-orb {
		width: 6px; height: 6px;
		border-radius: 50%;
		background: transparent;
		transition: background 0.2s ease;
	}
	.dropdown-content a {
		display: block;
	}
	.dropdown-content a:hover .lang-item {
		background: rgba(255, 255, 255, 0.05);
		color: #fff;
	}
	.dropdown-content a.active .lang-item {
		color: #fff;
		background: rgba(255, 255, 255, 0.03);
	}
	.dropdown-content a.active .lang-orb {
		background: var(--accent-4);
		box-shadow: 0 0 8px var(--accent-4);
	}

	.mobile-toggle {
		display: none;
		flex-direction: column;
		gap: 5px;
		background: none;
		border: none;
		cursor: pointer;
		padding: 0.5rem;
		z-index: 101;
	}
	.bar {
		width: 24px;
		height: 2px;
		background: #fff;
		border-radius: 2px;
		transition: all 0.3s ease;
	}

	.mobile-menu {
		position: fixed;
		inset: 0;
		background: rgba(3, 4, 6, 0.95);
		backdrop-filter: blur(30px);
		-webkit-backdrop-filter: blur(30px);
		z-index: 99;
		display: flex;
		align-items: center;
		justify-content: center;
		opacity: 0;
		visibility: hidden;
		transition: all 0.4s ease;
		overflow: hidden;
	}
	.mobile-bg-glow {
		position: absolute;
		width: 100vw; height: 100vh;
		background: radial-gradient(circle at center, rgba(0, 102, 255, 0.1), transparent 60%);
		z-index: -1;
	}
	.mobile-menu.active {
		opacity: 1;
		visibility: visible;
	}
	.mobile-links {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2.5rem;
		transform: translateY(30px);
		transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
	}
	.mobile-menu.active .mobile-links {
		transform: translateY(0);
	}
	.mobile-link {
		font-size: 2.5rem;
		font-weight: 800;
		color: var(--muted);
		letter-spacing: -0.03em;
		transition: all 0.3s ease;
	}
	.mobile-link:hover {
		color: #fff;
		transform: scale(1.05);
		text-shadow: 0 0 20px rgba(255,255,255,0.2);
	}

	.mobile-tools-box {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.8rem;
		margin-top: 1rem;
		padding-top: 1.5rem;
		border-top: 1px solid rgba(255, 255, 255, 0.1);
		width: 100%;
		max-width: 280px;
	}
	.mobile-tools-tag {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.15em;
		color: var(--accent-3);
	}
	.mobile-tools-grid {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		width: 100%;
	}
	.mobile-tool-card {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.75rem 1rem;
		background: rgba(255, 255, 255, 0.05);
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 12px;
		font-size: 1rem;
		font-weight: 600;
		color: #fff;
		transition: all 0.2s ease;
	}
	.mobile-tool-card:hover {
		background: rgba(255, 255, 255, 0.1);
		border-color: var(--accent-3);
		color: var(--accent-3);
	}

	@media (max-width: 1000px) {
		.nav-links { display: none; }
		.mobile-toggle { display: flex; }
		.mobile-toggle.active .bar:nth-child(1) { transform: translateY(7px) rotate(45deg); }
		.mobile-toggle.active .bar:nth-child(2) { opacity: 0; }
		.mobile-toggle.active .bar:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
	}

	@media (max-width: 480px) {
		.tools-txt { display: none; }
	}
</style>
