---
import { getLangFromUrl } from '../i18n/utils';
import BootSequence from '../components/BootSequence.astro';

interface Props {
	title: string;
}

const { title } = Astro.props;
const lang = getLangFromUrl(Astro.url);

const descriptions = {
	es: "Portfolio de Rubén Rodríguez Cazorla - Full Stack Developer",
	en: "Rubén Rodríguez Cazorla's Portfolio - Full Stack Developer",
	fr: "Portfolio de Rubén Rodríguez Cazorla - Développeur Full Stack",
	de: "Portfolio von Rubén Rodríguez Cazorla - Full Stack Entwickler",
	pt: "Portfolio de Rubén Rodríguez Cazorla - Programador Full Stack",
	ja: "Rubén Rodríguez Cazorlaのポートフォリオ - フルスタック開発者",
	zh: "Rubén Rodríguez Cazorla 的作品集 - 全栈开发人员",
	ko: "Rubén Rodríguez Cazorla 포트폴리오 - 풀스택 개발자"
};
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={descriptions[lang]} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@100..900&family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap" rel="stylesheet">
	</head>
	<body>
		<BootSequence />
		<div id="site-content">
			<slot />
		</div>
	</body>
</html>
<style is:global>
	:root {
		--bg: #030406;
		--surface: rgba(15, 20, 25, 0.6);
		--card: rgba(20, 25, 30, 0.4);
		--border: rgba(255, 255, 255, 0.08);
		--text: #f0f4f8;
		--muted: #8ba3b8;
		--accent-1: #ff3366;
		--accent-2: #ffcc00;
		--accent-3: #00ffcc;
		--accent-4: #0066ff;
		--accent-5: #9900ff;
		--font-main: 'Outfit', sans-serif;
		--font-mono: 'JetBrains Mono', monospace;
	}
	*, *::before, *::after {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}
	html {
		scroll-behavior: smooth;
	}
	body {
		background: var(--bg);
		background-image: radial-gradient(circle at top right, rgba(0, 102, 255, 0.08), transparent 40%),
						  radial-gradient(circle at bottom left, rgba(153, 0, 255, 0.08), transparent 40%);
		background-attachment: fixed;
		color: var(--text);
		font-family: var(--font-main);
		overflow-x: hidden;
		line-height: 1.6;
	}
	body.menu-open {
		overflow: hidden;
	}
	a {
		color: inherit;
		text-decoration: none;
	}
	section {
		padding: 6rem 8vw;
		position: relative;
	}
	.container {
		max-width: 1200px;
		margin: 0 auto;
		position: relative;
		z-index: 2;
	}
	.s-label {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.3em;
		text-transform: uppercase;
		color: var(--accent-3);
		margin-bottom: 0.5rem;
		display: block;
	}
	.s-title {
		font-size: clamp(2rem, 5vw, 4rem);
		font-weight: 900;
		margin-bottom: 2.5rem;
		line-height: 1.1;
		background: linear-gradient(135deg, #fff, var(--muted));
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}
	.divider {
		width: 100%;
		height: 1px;
		background: linear-gradient(90deg, transparent, rgba(255,255,255,0.1), transparent);
		margin: 2rem 0;
	}
	
	/* Boot sequence site content styles */
	#site-content {
		opacity: 0;
		transform: scale(0.985);
		transition: opacity .8s cubic-bezier(0.2, 0.8, 0.2, 1), transform .8s cubic-bezier(0.2, 0.8, 0.2, 1);
		min-height: 100vh;
		display: flex;
		flex-direction: column;
	}
	#site-content.show {
		opacity: 1;
		transform: scale(1);
	}
	
	@media (max-width: 800px) {
		section {
			padding: 4rem 6vw;
		}
	}
</style>
