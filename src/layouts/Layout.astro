---
import { getLangFromUrl } from '../i18n/utils';
import BootSequence from '../components/BootSequence.astro';

interface Props {
	title: string;
}

const { title } = Astro.props;
const lang = getLangFromUrl(Astro.url);

const descriptions = {
	es: "Portfolio de Rubén Rodríguez Cazorla - Full Stack Developer",
	en: "Rubén Rodríguez Cazorla's Portfolio - Full Stack Developer",
	fr: "Portfolio de Rubén Rodríguez Cazorla - Développeur Full Stack",
	de: "Portfolio von Rubén Rodríguez Cazorla - Full Stack Entwickler",
	pt: "Portfolio de Rubén Rodríguez Cazorla - Programador Full Stack",
	ja: "Rubén Rodríguez Cazorlaのポートフォリオ - フルスタック開発者",
	zh: "Rubén Rodríguez Cazorla 的作品集 - 全栈开发人员",
	ko: "Rubén Rodríguez Cazorla 포트폴리오 - 풀스택 개발자"
};
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={descriptions[lang]} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@100..900&family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap" rel="stylesheet">
	</head>
	<body>
		<BootSequence />
		<div id="site-content">
			<slot />
		</div>
	</body>
</html>
<style is:global>
	:root {
		--bg: #05080a;
		--surface: #090e11;
		--card: #0b1115;
		--border: #14281d;
		--text: #b9ffce;
		--muted: #5d7268;
		--accent-1: #4ade80; /* Neon Green */
		--accent-2: #06b6d4; /* Neon Cyan */
		--accent-3: #4ade80;
		--accent-4: #eab308; /* Cyber Yellow */
		--accent-5: #f43f5e; /* Neon Pink */
		--font-main: 'JetBrains Mono', monospace;
		--font-mono: 'JetBrains Mono', monospace;
	}
	*, *::before, *::after {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}
	html {
		scroll-behavior: smooth;
	}
	body {
		background-color: var(--bg);
		background-image: 
			linear-gradient(rgba(74, 222, 128, 0.03) 1px, transparent 1px),
			linear-gradient(90deg, rgba(74, 222, 128, 0.03) 1px, transparent 1px);
		background-size: 30px 30px;
		color: var(--text);
		font-family: var(--font-main);
		overflow-x: hidden;
		line-height: 1.6;
	}
	/* Scanline overlay */
	body::after {
		content: "";
		position: fixed;
		top: 0; left: 0; width: 100vw; height: 100vh;
		background: repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(0,0,0,0.15) 2px, rgba(0,0,0,0.15) 4px);
		pointer-events: none;
		z-index: 9999;
	}
	body.menu-open {
		overflow: hidden;
	}
	a {
		color: inherit;
		text-decoration: none;
	}
	section {
		padding: 6rem 8vw;
	}
	.container {
		max-width: 1200px;
		margin: 0 auto;
	}
	.s-label {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--accent-1);
		margin-bottom: 0.5rem;
		display: inline-block;
		border-bottom: 1px dashed var(--accent-1);
		padding-bottom: 2px;
	}
	.s-label::before { content: '// '; }
	.s-title {
		font-family: var(--font-mono);
		font-size: clamp(2rem, 5vw, 3.5rem);
		font-weight: 800;
		margin-bottom: 2.5rem;
		line-height: 1.1;
		color: var(--text);
		text-transform: uppercase;
		text-shadow: 2px 2px 0px rgba(6, 182, 212, 0.5);
	}
	.divider {
		width: 100%;
		height: 2px;
		background: repeating-linear-gradient(90deg, var(--accent-2), var(--accent-2) 10px, transparent 10px, transparent 20px);
		opacity: 0.3;
		margin: 2rem 0;
	}
	@media (max-width: 800px) {
		section {
			padding: 4rem 6vw;
		}
	}

	/* Boot sequence site content styles */
	#site-content {
		opacity: 0;
		transform: scale(0.985);
		transition: opacity .6s ease, transform .6s ease;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
	}
	#site-content.show {
		opacity: 1;
		transform: scale(1);
	}

	/* Glitch Effect */
	.glitch-wrapper {
		position: relative;
		display: inline-block;
	}
	.glitch {
		position: relative;
		color: var(--text);
		font-weight: bold;
	}
	.glitch::before,
	.glitch::after {
		content: attr(data-text);
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: var(--bg);
	}
	.glitch::before {
		left: 2px;
		text-shadow: -2px 0 var(--accent-1);
		clip: rect(44px, 450px, 56px, 0);
		animation: glitch-anim 5s infinite linear alternate-reverse;
	}
	.glitch::after {
		left: -2px;
		text-shadow: -2px 0 var(--accent-2);
		clip: rect(44px, 450px, 56px, 0);
		animation: glitch-anim2 5s infinite linear alternate-reverse;
	}
	@keyframes glitch-anim {
		0% { clip: rect(61px, 9999px, 52px, 0); }
		5% { clip: rect(33px, 9999px, 14px, 0); }
		10% { clip: rect(98px, 9999px, 81px, 0); }
		15% { clip: rect(2px, 9999px, 20px, 0); }
		20% { clip: rect(10px, 9999px, 43px, 0); }
		25% { clip: rect(66px, 9999px, 34px, 0); }
		30% { clip: rect(81px, 9999px, 92px, 0); }
		35% { clip: rect(11px, 9999px, 16px, 0); }
		40% { clip: rect(51px, 9999px, 39px, 0); }
		45% { clip: rect(25px, 9999px, 12px, 0); }
		50% { clip: rect(7px, 9999px, 83px, 0); }
		55% { clip: rect(94px, 9999px, 2px, 0); }
		60% { clip: rect(89px, 9999px, 15px, 0); }
		65% { clip: rect(46px, 9999px, 55px, 0); }
		70% { clip: rect(6px, 9999px, 30px, 0); }
		75% { clip: rect(29px, 9999px, 18px, 0); }
		80% { clip: rect(78px, 9999px, 41px, 0); }
		85% { clip: rect(41px, 9999px, 50px, 0); }
		90% { clip: rect(16px, 9999px, 60px, 0); }
		95% { clip: rect(55px, 9999px, 90px, 0); }
		100% { clip: rect(22px, 9999px, 37px, 0); }
	}
	@keyframes glitch-anim2 {
		0% { clip: rect(24px, 9999px, 92px, 0); }
		5% { clip: rect(15px, 9999px, 51px, 0); }
		10% { clip: rect(66px, 9999px, 7px, 0); }
		15% { clip: rect(2px, 9999px, 88px, 0); }
		20% { clip: rect(31px, 9999px, 4px, 0); }
		25% { clip: rect(99px, 9999px, 55px, 0); }
		30% { clip: rect(45px, 9999px, 20px, 0); }
		35% { clip: rect(82px, 9999px, 37px, 0); }
		40% { clip: rect(12px, 9999px, 63px, 0); }
		45% { clip: rect(74px, 9999px, 18px, 0); }
		50% { clip: rect(88px, 9999px, 99px, 0); }
		55% { clip: rect(39px, 9999px, 44px, 0); }
		60% { clip: rect(56px, 9999px, 22px, 0); }
		65% { clip: rect(1px, 9999px, 77px, 0); }
		70% { clip: rect(69px, 9999px, 30px, 0); }
		75% { clip: rect(22px, 9999px, 5px, 0); }
		80% { clip: rect(44px, 9999px, 82px, 0); }
		85% { clip: rect(93px, 9999px, 14px, 0); }
		90% { clip: rect(5px, 9999px, 66px, 0); }
		95% { clip: rect(33px, 9999px, 49px, 0); }
		100% { clip: rect(77px, 9999px, 91px, 0); }
	}
</style>
